0xjah.xyz, www.0xjah.xyz {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
	reverse_proxy 127.0.0.1:26062 {
		header_down -Server
	}
}

# LimeSurvey for the Hikerji surveys: /srv/limesurvey, php-fpm pool "limesurvey".
# Secrets live in /root/limesurvey.secrets on the server, never here.
(limesurvey_common) {
	root * /srv/limesurvey
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
	# Never served (LimeSurvey security docs): code, config, private tmp, respondent uploads, dotfiles.
	@limesurvey_private {
		path /application/* /vendor/* /node_modules/* /framework/* /installer/* /locale/* /docs/* /modules/* /tests/* /protected/*
		path /themes/*/views/* /upload/surveys/*/files/* /upload/surveys/*/fu_* /upload/admintheme/* /.*
		path *.sql *.md *.lock composer.json manifest.yml
	}
	respond @limesurvey_private 404
	# tmp/ holds LimeSurvey's private working files; only the published assets are public.
	@limesurvey_tmp {
		path /tmp/*
		not path /tmp/assets/*
	}
	respond @limesurvey_tmp 404
	# index.php is the only script LimeSurvey needs.
	@limesurvey_other_php {
		path *.php
		not path /index.php
	}
	respond @limesurvey_other_php 404
	php_fastcgi unix//run/php/limesurvey.sock
	file_server
}

# Public survey pages only. Everything else under index.php (admin, API, statistics) is not routed here.
survey.0xjah.xyz {
	# Short links printed on the invitation PDF and its QR codes.
	redir /organizers /index.php/151526?lang=ar 302
	redir /hikers /index.php/197353?lang=ar 302

	@survey_admin_or_api {
		not path_regexp ^/index\.php/(?:\d+|survey/|verification/image|uploader/|optout/|optin/|register/|printanswers/)
		path /index.php/* /admin /admin/*
	}
	@survey_route_param query r=*
	respond @survey_admin_or_api 404
	respond @survey_route_param 404
	import limesurvey_common
}

# Admin, only over Tailscale: valid HTTPS from tailscaled (TS_PERMIT_CERT_UID=caddy).
nexus.tail2013b3.ts.net {
	@not_tailnet not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @not_tailnet
	redir / /index.php/admin 302
	import limesurvey_common
}
